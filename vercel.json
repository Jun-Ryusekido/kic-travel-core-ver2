{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "guide.html", "use": "@vercel/static" },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/guide_settlement_jp.pdf", "destination": "/public/guide_settlement_jp.pdf" },
    { "source": "/guide_settlement_en.pdf", "destination": "/public/guide_settlement_en.pdf" },
    { "source": "/guide.html", "destination": "/guide.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
