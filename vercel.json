{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "guide.html", "use": "@vercel/static" },
    { "src": "arrangement_excel.js", "use": "@vercel/static" },
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/generate-haichisho", "dest": "/api/generate-haichisho.js" },
    { "src": "/api/extract-card", "dest": "/api/extract-card.js" },
    { "src": "/api/extract-multi-locations", "dest": "/api/extract-multi-locations.js" },
    { "src": "/api/extract-partner", "dest": "/api/extract-partner.js" },
    { "src": "/api/extract-receipt", "dest": "/api/extract-receipt.js" },
    { "src": "/api/extract-bankbook", "dest": "/api/extract-bankbook.js" },
    { "src": "/api/extract-cardstatement", "dest": "/api/extract-cardstatement.js" },
    { "src": "/api/extract-email-refs", "dest": "/api/extract-email-refs.js" },
    { "src": "/api/classify-email-relevance", "dest": "/api/classify-email-relevance.js" },
    { "src": "/api/login", "dest": "/api/login.js" },
    { "src": "/api/change-password", "dest": "/api/change-password.js" },
    { "src": "/api/list-users", "dest": "/api/list-users.js" },
    { "src": "/api/add-user", "dest": "/api/add-user.js" },
    { "src": "/api/booking-sales", "dest": "/api/booking-sales.js" },
    { "src": "/api/booking-costs", "dest": "/api/booking-costs.js" },
    { "src": "/api/parking-reservations", "dest": "/api/parking-reservations.js" },
    { "src": "/guide_settlement_jp.pdf", "dest": "/public/guide_settlement_jp.pdf" },
    { "src": "/guide_settlement_en.pdf", "dest": "/public/guide_settlement_en.pdf" },
    { "src": "/kic-logo.png", "dest": "/public/kic-logo.png" },
    { "src": "/kic_travel_logo.jpg", "dest": "/public/kic_travel_logo.jpg" },
    { "src": "/kic_travel_logo_final.png", "dest": "/public/kic_travel_logo_final.png" },
    { "src": "/kic_stamp_v2.png", "dest": "/public/kic_stamp_v2.png" },
    { "src": "/tour_arrangement_template.xlsx", "dest": "/public/tour_arrangement_template.xlsx" },
    { "src": "/guide.html", "dest": "/guide.html" },
    { "src": "/arrangement_excel.js", "dest": "/arrangement_excel.js" },
    { "src": "/", "dest": "/index.html" }
  ]
}
